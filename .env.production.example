# Public domains (DNS must point to the server)
APP_DOMAIN=avocat.example.com
API_DOMAIN=api.avocat.example.com
SEARCH_DOMAIN=search.avocat.example.com

# Laravel
APP_NAME="Legal Vista Suite"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://api.avocat.example.com
FRONTEND_URLS=https://avocat.example.com
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
LOG_CHANNEL=stack
LOG_LEVEL=warning

# PostgreSQL
DB_CONNECTION=pgsql
DB_HOST=pg
DB_PORT=5432
DB_DATABASE=avocat
DB_USERNAME=avocat
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Sessions / cache / queue
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=redis
QUEUE_CONNECTION=database
REDIS_CLIENT=phpredis
REDIS_HOST=cache
REDIS_PORT=6379
REDIS_PASSWORD=null

# Mail (configure when needed)
MAIL_MAILER=log
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="Legal Vista Suite"
