name: "3.9"

services:
  db:
    image: postgres:16-alpine
    container_name: e360-db
    restart: unless-stopped
    environment:
      POSTGRES_DB: app
      POSTGRES_USER: app
      POSTGRES_PASSWORD: app_password
    volumes:
      - db-data:/var/lib/postgresql/data
    ports:
      - "55432:5432"
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U app -d app"]
      interval: 10s
      timeout: 5s
      retries: 30

  redis:
    image: redis:7-alpine
    container_name: e360-redis
    restart: unless-stopped
    ports:
      - "6379:6379"

  backend:
    build:
      context: ./avocatapp
      dockerfile: Dockerfile
    container_name: e360-avocatapp
    restart: unless-stopped
    env_file:
      - ./avocatapp/.env.docker
    volumes:
      - ./avocatapp:/var/www/html
      - avocatapp-vendor:/var/www/html/vendor
    depends_on:
      db:
        condition: service_healthy
      redis:
        condition: service_started
    ports:
      - "8000:8000"

  avocat-frontend:
    image: node:20-alpine
    container_name: e360-avocat-frontend
    working_dir: /usr/src/app
    volumes:
      - ./avocat-frontend:/usr/src/app
      - avocat-frontend-node-modules:/usr/src/app/node_modules
    ports:
      - "8088:8080"
    command: sh -c "npm install && npm run dev -- --host 0.0.0.0 --port=8080"

volumes:
  db-data:
  avocatapp-vendor:
  avocat-frontend-node-modules:
