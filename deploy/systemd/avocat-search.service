[Unit]
Description=Avocat FastAPI search service
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/avocat/search-api
EnvironmentFile=-/etc/avocat/search-api.env
ExecStart=/var/www/avocat/search-api/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 9100 --workers 1 --proxy-headers
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
